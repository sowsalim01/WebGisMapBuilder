{
  "name": "Dashboard",
  "description": "Web map with sidebar for statistics and layer controls",
  "version": "1.0",
  "author": "WebGisMapBuilder",
  "features": [
    "Leaflet integration",
    "Sidebar layout",
    "Statistics panel",
    "Layer control",
    "Popups",
    "Responsive design"
  ],
  "supported_layer_types": ["point", "line", "polygon"],
  "default_settings": {
    "map": {
      "center": [0, 0],
      "zoom": 2
    },
    "ui": {
      "show_zoom_control": true,
      "show_scale_control": true,
      "show_layer_control": true,
      "sidebar_width": 300
    }
  }
}
